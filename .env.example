# Keep the mock provider until you are ready to make a paid API call.
AGENT_LLM_PROVIDER=mock

# Alibaba Cloud Model Studio / DashScope. Never commit the real key.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus-2026-05-26
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=60

# Optional fixed access code for LAN sharing (LAN=1 ./scripts/dev.sh). Leave empty for a random one per start.
AGENT_ACCESS_CODE=
